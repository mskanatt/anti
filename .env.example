# Скопируйте в .env и заполните. Файл .env НЕЛЬЗЯ коммитить в git.

# --- Обязательно ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Код, без которого нельзя создать аккаунт администрации (минимум 8 символов)
STAFF_INVITE_CODE=

# --- База данных ---
DATABASE_URL=sqlite:///./antibullying.db

# --- Telegram (дублирующий канал, необязательно) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web Push (необязательно). Ключи: python scripts/gen_vapid.py ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT=mailto:security@your-school.example

# --- Параметры детекции ---
MIN_CONFIDENCE=0.6
ALERT_COOLDOWN_SECONDS=20
DISPLAY_TIMEZONE=UTC